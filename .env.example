# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Neon PostgreSQL Database Connection String (Free Serverless DB on https://neon.tech)
# Example: postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# JWT signing secret for admin session tokens. Required at runtime.
# Generate a cryptographically random value with at least 32 bytes.
# Never commit the real value; set it in Vercel Environment Variables.
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES"

# Admin authentication. All values are deployment secrets/configuration.
# Set ADMIN_EMAIL and either ADMIN_PASSWORD or ADMIN_PASSWORD_HASH.
# ADMIN_PASSWORD_HASH must be a bcrypt hash generated for your new password.
# Optional username and display name:
ADMIN_EMAIL="admin@example.com"
ADMIN_USERNAME=""
ADMIN_NAME="JD Fusion Administrator"
ADMIN_PASSWORD="REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD"
# ADMIN_PASSWORD_HASH=""

